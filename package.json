{
  "name": "skynet-ebilling",
  "version": "1.0.0",
  "description": "SkyNet eBilling - ISP Billing Management System",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npx vite build",
    "typecheck": "tsc --noEmit && npm run lint:a11y",
    "lint:a11y": "eslint resources/js",
    "e2e:install": "cd e2e && npm install && npx playwright install chromium",
    "e2e:audit": "cd e2e && npx playwright test",
    "e2e:report": "cd e2e && npx playwright show-report e2e-report",
    "faq:screenshots": "cd e2e && npx playwright test -c playwright.faq-screenshots.config.ts"
  },
