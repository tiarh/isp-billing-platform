APP_NAME="ISP Billing Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

TRUSTED_PROXIES=127.0.0.1/32

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=billing
DB_USERNAME=billing
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=480

TOTP_ISSUER=BillingDemo
TOTP_ALGORITHM=SHA1
TOTP_DIGITS=6
TOTP_PERIOD=30
TOTP_RECOVERY_CODES=8

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="billing@example.test"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Demo data (only used when APP_ENV=testing): login admin@local with this password.
E2E_PASSWORD=

# Isolation portal stays off in the demo.
ISOLATION_PORTAL_ENABLED=false
ISOLATION_PORTAL_TEST_MODE=true
ISOLATION_PORTAL_AREAS=[]

# Fallback SNMP community for OLTs without their own value. Empty by default.
OLT_SNMP_COMMUNITY=

VITE_APP_NAME="${APP_NAME}"
ASSET_URL=

# WhatsApp gateway (Evolution API). Leave empty: the demo sends nothing.
WA_PROVIDER=evolution_api
WA_SIGNALS_EXPORT_SALT=

MONITORING_OPERATOR_HOLD=false
